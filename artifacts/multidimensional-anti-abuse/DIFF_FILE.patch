+			req.Header.Set("X-JA3", strings.Repeat("a", 32))
+			req.Header.Set("X-JA4", "t13d1714h1_5b57614c22b0_7baf387fc6ff")
+			r.ServeHTTP(w, req)
+			require.Equal(t, 200, w.Code)
+		})
+	}
+}
