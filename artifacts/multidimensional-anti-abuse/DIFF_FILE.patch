+	} else if usage != nil {
+		updates = buildCodexQuotaWindowExtraUpdates(usage.RateLimit, now)
+	}
+	if len(updates) > 0 {
+		return updates
+	}
+	return map[string]any{
+		"codex_5h_used_percent":  0.0,
+		"codex_7d_used_percent":  0.0,
+		"codex_usage_updated_at": now.UTC().Format(time.RFC3339),
 	}
