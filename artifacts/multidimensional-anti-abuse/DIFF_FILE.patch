+		{name: "untrusted peer", remoteAddr: "9.9.9.9:54321"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Server.TrustedProxiesConfigured = true
+			cfg.Server.TrustedProxies = []string{"127.0.0.1/32"}
