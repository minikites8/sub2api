+// AutoClearExpiredOpenAIRateLimits removes elapsed account-level quota blocks.
+// The manual schedulable switch is preserved; the scheduler outbox rebuilds only
+// the affected OpenAI buckets so eligible OAuth accounts resume promptly.
+func (r *accountRepository) AutoClearExpiredOpenAIRateLimits(ctx context.Context, now time.Time) (int64, error) {
+	rows, err := r.sql.QueryContext(ctx, `
+		UPDATE accounts
+		SET rate_limited_at = NULL,
+			rate_limit_reset_at = NULL,
+			updated_at = NOW()
+		WHERE deleted_at IS NULL
+			AND platform = $2
+			AND type = $3
+			AND rate_limit_reset_at IS NOT NULL
+			AND rate_limit_reset_at <= $1
+		RETURNING id
+	`, now, service.PlatformOpenAI, service.AccountTypeOAuth)
+	if err != nil {
+		return 0, err
+	}
+	defer func() {
+		_ = rows.Close()
+	}()
+
+	accountIDs := make([]int64, 0)
+	for rows.Next() {
+		var accountID int64
+		if err := rows.Scan(&accountID); err != nil {
+			return 0, err
+		}
+		accountIDs = append(accountIDs, accountID)
+	}
+	if err := rows.Err(); err != nil {
+		return 0, err
+	}
+
+	if len(accountIDs) > 0 {
+		payload := map[string]any{"account_ids": accountIDs}
+		if err := enqueueSchedulerOutbox(ctx, r.sql, service.SchedulerOutboxEventAccountBulkChanged, nil, nil, payload); err != nil {
+			logger.LegacyPrintf("repository.account", "[SchedulerOutbox] enqueue expired OpenAI OAuth rate-limit recovery failed: err=%v", err)
+		}
+	}
+	return int64(len(accountIDs)), nil
+}
+
+func (r *accountRepository) ListRateLimitedOpenAIOAuthAccounts(ctx context.Context, afterID int64, limit int) ([]service.Account, error) {
+	if limit <= 0 {
+		return []service.Account{}, nil
+	}
+	rows, err := r.sql.QueryContext(ctx, `
+		SELECT id, parent_account_id, quota_dimension, rate_limited_at, rate_limit_reset_at
+		FROM accounts
+		WHERE deleted_at IS NULL
+			AND id > $1
+			AND rate_limited_at IS NOT NULL
+			AND rate_limit_reset_at > $2
+			AND platform = $3
+			AND type = $4
+			AND status = $5
+			AND schedulable = TRUE
+			AND (auto_pause_on_expired = FALSE OR expires_at IS NULL OR expires_at > $2)
+		ORDER BY id ASC
+		LIMIT $6
+	`, afterID, time.Now(), service.PlatformOpenAI, service.AccountTypeOAuth, service.StatusActive, limit)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = rows.Close() }()
+
+	accounts := make([]service.Account, 0, limit)
+	for rows.Next() {
+		var account service.Account
+		if err := rows.Scan(&account.ID, &account.ParentAccountID, &account.QuotaDimension, &account.RateLimitedAt, &account.RateLimitResetAt); err != nil {
+			return nil, err
+		}
+		accounts = append(accounts, account)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return accounts, nil
+}
+
+// ClearOpenAIRateLimitIfObserved clears the exact rate-limit generation that a
+// successful quota probe observed. A concurrent newer 429 remains intact.
+func (r *accountRepository) ClearOpenAIRateLimitIfObserved(ctx context.Context, id int64, observedLimitedAt, observedResetAt time.Time) (bool, error) {
+	result, err := r.sql.ExecContext(ctx, `
+		UPDATE accounts
+		SET rate_limited_at = NULL,
+			rate_limit_reset_at = NULL,
+			updated_at = NOW()
+		WHERE id = $1
+			AND deleted_at IS NULL
+			AND platform = $4
+			AND type = $5
+			AND rate_limited_at = $2
+			AND rate_limit_reset_at = $3
+	`, id, observedLimitedAt, observedResetAt, service.PlatformOpenAI, service.AccountTypeOAuth)
+	if err != nil {
+		return false, err
+	}
+	updated, err := result.RowsAffected()
+	if err != nil {
+		return false, err
+	}
+	if updated == 0 {
+		r.syncSchedulerAccountSnapshot(ctx, id)
+		return false, nil
+	}
+	if err := enqueueSchedulerOutbox(ctx, r.sql, service.SchedulerOutboxEventAccountChanged, &id, nil, map[string]any{
+		"runtime_recovered": "openai_quota",
+	}); err != nil {
+		logger.LegacyPrintf("repository.account", "[SchedulerOutbox] enqueue observed OpenAI rate-limit clear failed: account=%d err=%v", id, err)
+	}
+	r.syncSchedulerAccountSnapshot(ctx, id)
+	return true, nil
+}
