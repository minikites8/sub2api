+func applyGroupOpenAIServiceTierPolicy(ctx context.Context, body []byte) ([]byte, error) {
+    if len(body) == 0 || ctx == nil {
+        return body, nil
+    }
+    group, ok := ctx.Value(ctxkey.Group).(*Group)
+    if !ok || !IsGroupContextValid(group) || group.Platform != PlatformOpenAI {
+        return body, nil
+    }
+    mode, tier, err := NormalizeOpenAIServiceTierConfig(group.Platform, group.OpenAIServiceTierMode, group.OpenAIServiceTier)
+    if err != nil {
+        return body, fmt.Errorf("invalid group openai service_tier policy: %w", err)
+    }
+    switch mode {
+    case OpenAIServiceTierModeSet:
+        updated, setErr := sjson.SetBytes(body, "service_tier", tier)
+        if setErr != nil {
+            return body, fmt.Errorf("set group service_tier on body: %w", setErr)
+        }
+        return updated, nil
+    case OpenAIServiceTierModeClear:
+        if !gjson.GetBytes(body, "service_tier").Exists() {
+            return body, nil
+        }
+        updated, deleteErr := sjson.DeleteBytes(body, "service_tier")
+        if deleteErr != nil {
+            return body, fmt.Errorf("clear group service_tier from body: %w", deleteErr)
+        }
+        return updated, nil
+    default:
+        return body, nil
+    }
+}
