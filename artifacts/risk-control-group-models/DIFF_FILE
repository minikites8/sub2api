+func normalizeContentModerationGroupModelOverrides(overrides map[int64]string) map[int64]string {
+	if len(overrides) == 0 {
+		return map[int64]string{}
+	}
+	out := make(map[int64]string, len(overrides))
+	for groupID, rawModel := range overrides {
+		if groupID <= 0 {
+			continue
+		}
+		model := trimRunes(strings.TrimSpace(rawModel), maxContentModerationModelFilterRunes)
+		if model == "" {
+			continue
+		}
+		out[groupID] = model
+	}
+	return out
+}
